# State files (may contain sensitive information)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files (may contain passwords, secrets, etc.)
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example

# Plan files
*.tfplan
*.plan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# Environment and secrets
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Provider plugins and local working directory
.terraform/

# Generated by the local_file resources
output_files/
